[node name="Help" type="Label" parent="HUD/Panel/Column" unique_id=804411718]
custom_minimum_size = Vector2(560, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.95, 0.94, 0.9, 1)
text = "Little Peak test room
WASD or left stick: move (camera-relative). Mouse or right stick: look.
Click to capture the mouse. Esc releases it. Tab (or Start) opens travel and frees the mouse. F1 hides this text.
Space or A: jump (tap for a short hop, hold for full). Coyote time and a jump buffer are on.
Jump into a Climbable (gray) to climb. Space while climbing hops (costs a chunk of stamina). Space while holding back lets go.
The bird gifts wings. Shift or LB: glide once you have them, while falling. Glide spends stamina.
E or X: talk to the bird, or roast a marshmallow at a campfire. Roasting unlocks that campsite.
Stamina drains while climbing, hopping, and gliding. It refills on solid ground and at an unlocked fire. Running and jumping are free.
Blue is unclimbable. The steep ramp slides. The convex pillar and the concave corner are both climbable."
autowrap_mode = 3

